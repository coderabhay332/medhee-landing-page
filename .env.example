# Waitlist form → Google Apps Script web app URL (exposed to browser).
NEXT_PUBLIC_SHEETS_WEBHOOK="YOUR_APPS_SCRIPT_WEB_APP_URL"

# DynamoDB drug library — server-side only, never sent to the browser.
# The drug pages read these at build (SSG) and during ISR revalidation.
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
DYNAMO_TABLE_DRUG_ARTICLES="drug_articles"
